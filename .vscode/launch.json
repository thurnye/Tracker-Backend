{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Run DonationsTracker API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/DonationsTracker.Api/bin/Debug/net8.0/DonationsTracker.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/DonationsTracker.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/DonationsTracker.Api/Views"
      },
      
    }
  ]
}